# Copiar a .env y completar con el token real (nunca commitear).
CLOUDFLARE_API_TOKEN=

DOMAINS=laborin.app,www.laborin.app,mx.laborin.app,laborin-webmail.laborin.app

# false para mx.laborin.app (SMTP directo), true para el resto.
PROXIED=!is(mx.laborin.app)

IP6_PROVIDER=none
UPDATE_CRON=@every 5m
