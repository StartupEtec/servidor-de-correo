# Copiar a mailserver/.env y completar con valores reales. NUNCA commitear.

DOMAIN_NAME=laborin.app

# Relay SMTP saliente (Brevo). Si no se usa, dejar vacíos usuario y password.
RELAY_HOST=smtp-relay.brevo.com
RELAY_PORT=587
RELAY_USER=
RELAY_PASSWORD=

# Base de datos del webmail (Roundcube)
MYSQL_ROOT_PASS=
MYSQL_DB=roundcube
MYSQL_USER=
MYSQL_PASS=

# Ruta donde viven los volúmenes reales en el servidor
MAILSERVER_DATA_DIR=/home/Startup/runtime/mailserver/data
